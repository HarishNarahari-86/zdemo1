projection;
strict ( 2 );
use draft;

define behavior for z_i_m_p_travel3 alias travel
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Resume;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _book { create; }
}

define behavior for z_i_m_p_book3 alias booking
{
  use update;
  use delete;

  use association _travel;
  use association _suppliment { create; }
}

define behavior for z_i_m_p_book_s3 alias booksuppl
{
  use update;
  use delete;

  use association _travel;
  use association _book;
}
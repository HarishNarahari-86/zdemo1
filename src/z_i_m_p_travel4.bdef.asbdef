projection;
strict ( 2 );
use draft;

define behavior for z_i_m_p_travel4 alias travel
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _booking { create; }

}

define behavior for z_i_m_p_book4 alias booking
{
  use update;
  use delete;

  use association _travel;
  use association _suppl { create; }
}

define behavior for z_i_m_p_book_s4 alias suppl
{
  use update;
  use delete;

  use association _travel;
  use association _booking;
}